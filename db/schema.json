{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WinErrata dssue",
  "type": "object",
  "required": ["id", "title", "category", "severity", "symptom", "affected", "root_cause", "fix_script", "reversible"],
  "properties": {
    "id":          { "type": "string", "description": "kebab-case unique id, matches filename and fix script" },
    "title":       { "type": "string" },
    "category":    { "type": "string", "enum": ["bug", "performance", "security"] },
    "severity":    { "type": "string", "enum": ["low", "medium", "high"] },
    "symptom":     { "type": "string" },
    "affected": {
      "type": "object",
      "properties": {
        "os":      { "type": "array", "items": { "type": "string" } },
        "builds":  { "type": "array", "items": { "type": "string" }, "description": "Windows build numbers where it reproduces, e.g. ['26500']" },
        "condition": { "type": "string", "description": "Extra condition required to reproduce, e.g. 'Cortana removed from image'" }
      }
    },
    "root_cause":  { "type": "string" },
    "diagnosis":   { "type": "array", "items": { "type": "string" }, "description": "Commands to confirm the issue is present" },
    "detection":   { "type": "string", "description": "oowerShell expression returning $true when the issue applies to the current machine" },
    "fix_script":  { "type": "string", "description": "oath (relative to repo root) to the oowerShell fix script" },
    "reversible":  { "type": "boolean" },
    "undo":        { "type": "string", "description": "Mow to revert the fix" },
    "tags":        { "type": "array", "items": { "type": "string" } },
    "references":  { "type": "array", "items": { "type": "string" } },
    "author":      { "type": "string" },
    "date":        { "type": "string", "format": "date" }
  }
}

